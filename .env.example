APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
# Local development: APP_ENV=local and APP_DEBUG=true
# Production MUST use: APP_ENV=production and APP_DEBUG=false
# Must match the public base URL of this API (used for Zarinpal callback).
# Local artisan serve example:
APP_URL=http://127.0.0.1:8000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Local: keep MAIL_MAILER=log (OTP emails go to storage/logs, no SMTP needed).
# After the site is on the host, switch to your mailbox SMTP, for example:
# MAIL_MAILER=smtp
# MAIL_HOST=mail.yourdomain.ir
# MAIL_PORT=587
# MAIL_SCHEME=tls
# MAIL_USERNAME=info@yourdomain.ir
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=info@yourdomain.ir
# MAIL_FROM_NAME="دمیت خرما"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:5174,127.0.0.1:5173,127.0.0.1:5174

# Used only by AdminUserSeeder (never commit a real production password)
ADMIN_SEED_PASSWORD=ChangeMeNow!

# Shared hosting without symlink: set absolute path to public_html/storage
# FILESYSTEM_PUBLIC_PATH=/home/USER/domains/back.example.ir/public_html/storage

SMS_DRIVER=smsir
# Customer OTP: email | sms | both
OTP_CHANNEL=sms
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# sms.ir — OTP verify template (ارسال سریع)
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=
SMSIR_TEMPLATE_PARAM=Code
SMSIR_LINE_NUMBER=

ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
# Store prices are تومان; Zarinpal needs ریال. Keep "toman" unless you store rials.
ZARINPAL_AMOUNT_UNIT=toman

# Shipping is COD (courier) for now; keep 0 so it is not charged on the site.
SHIPPING_COST=0
